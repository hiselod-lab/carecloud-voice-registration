# Run python scripts/setup_env.py to generate unique local demo credentials.
# Never commit .env or paste real credentials into a repository.
API_BEARER_TOKEN=
VAPI_WEBHOOK_SECRET=
# Local SQLite is durable only while this file/volume is retained.
DATABASE_URL=sqlite:///./data/patients.db
# Railway: recommended DATABASE_URL=${{Postgres.DATABASE_URL}} in service variables.
# Alternative: mount a persistent volume at /app/data for SQLite.
# Railway volumes are root-owned; prefer PostgreSQL for non-root deployment.
VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=
# Explicitly enable only with synthetic data. Logs include full registration payloads.
DEMO_LOG_PAYLOADS=false
ENVIRONMENT=development
PORT=8000
